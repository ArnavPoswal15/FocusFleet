# Copy to .env (local only) or export these variables before starting Uvicorn.
# Do not commit a real .env file with secrets.

# Fleet admin (created once on API startup if no admin exists in the DB)
FOCUSFLEET_ADMIN_USERNAME=admin
FOCUSFLEET_ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional
# FOCUSFLEET_SECRET_KEY=generate-a-long-random-string
# FOCUSFLEET_CORS_ORIGINS=http://localhost:3000
# FOCUSFLEET_DATA_DIR=/data
